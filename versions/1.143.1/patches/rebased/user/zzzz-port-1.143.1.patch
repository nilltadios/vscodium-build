-	return {
-		kind: 'patch',
-		body: { ...response, selected_model: patchSelectedModel(selected, limits, serving.displayName, serving.thinking ? fallback.reasoningEfforts : undefined) },
-		sessionToken: response.session_token,
-		fallback,

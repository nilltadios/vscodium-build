-	if (Array.isArray(body.tools)) {
-		const tools = body.tools.filter(tool => isObject(tool) && tool.type === 'function');
-		if (tools.length) {
-			result.tools = tools;
-		} else {
-			delete result.tools;
-			delete result.tool_choice;
-		}

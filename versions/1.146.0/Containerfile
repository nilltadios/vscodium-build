ARG BASE_IMAGE=docker.io/library/node:24.22.1-bookworm@sha256:0925478b811e8890f5508ad2a75135933310effd45492696ecf7c111c8339d02
FROM ${BASE_IMAGE}
# pnpm: the version VS Code's package.json pins in packageManager (scripts/image-tag.sh checks they agree).
# SHA-256 of the registry tarball, whose sha512 matches the registry's dist.integrity (checked 2026-11-12).
ARG PNPM_VERSION=12.16.0
ARG PNPM_SHA256=27711dcf64784549d4d617fcc114062e25c2b5d49d5ee53fede8895541967670
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang ccache git curl jq pkg-config python3 python3-setuptools \
    libx11-dev libxkbfile-dev libsecret-1-dev libkrb5-dev libssl-dev \
    libgtk-3-0 libnss3 libasound2 libgbm1 libxss1 libxshmfence1 \
    ca-certificates xz-utils zip unzip patch time \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSLo /tmp/pnpm.tgz "https://registry.npmjs.org/pnpm/-/pnpm-${PNPM_VERSION}.tgz" \
    && echo "${PNPM_SHA256}  /tmp/pnpm.tgz" | sha256sum -c - \
    && npm install -g --no-audit --no-fund /tmp/pnpm.tgz \
    && rm /tmp/pnpm.tgz && pnpm --version
ENV npm_config_cache=/project/cache/npm \
    pnpm_config_store_dir=/project/cache/pnpm-store \
    ELECTRON_CACHE=/project/cache/electron \
    XDG_CACHE_HOME=/project/cache/xdg \
    CCACHE_DIR=/project/cache/ccache \
    npm_config_jobs=4
WORKDIR /project
